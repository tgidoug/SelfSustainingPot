from machine import Pin, PWM
import time

servo = PWM(Pin(14))
servo.freq(50)

START_US = 1500
TARGET_US = 2325
DURATION_MS = 8000
UPDATE_MS = 20

def set_position(pulse_us):
    duty = int(pulse_us * 65535 / 20000)
    servo.duty_u16(duty)

try:
    set_position(START_US)
    time.sleep(1)

    steps = DURATION_MS // UPDATE_MS

    for step in range(steps + 1):
        progress = step / steps

        # Smooth acceleration and deceleration
        smooth = progress * progress * (3 - 2 * progress)

        pulse = START_US + (TARGET_US - START_US) * smooth
        set_position(pulse)

        time.sleep_ms(UPDATE_MS)

    print("Movement complete; holding position.")

except KeyboardInterrupt:
    servo.duty_u16(0)
    servo.deinit()
    print("Servo pulses stopped.")
    time.sleep(1)




