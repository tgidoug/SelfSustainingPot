from machine import Pin, ADC, I2C, PWM
import dht
import time

# ==================================================
# CALIBRATION: replace None with YOUR measured values
# ==================================================

SOIL_DRY_RAW = 2000       # Higher raw reading in dry soil
SOIL_WET_RAW = 800       # Lower reading in thoroughly wet,
                          # drained soil

LIGHT_DARK_RAW = 20000     # Reading with sensor covered
LIGHT_PEAK_RAW = 65000     # Reading in direct peak sunlight

# These are relative calibrated percentages,
# NOT laboratory soil-water content or PAR measurements.

# ==================================================
# CONTROL SETTINGS
# ==================================================

SOIL_START_PERCENT = 40

SHADE_CLOSE_F = 86
SHADE_EMERGENCY_F = 95
SHADE_OPEN_F = 81

LIGHT_CLOSE_PERCENT = 80
LIGHT_OPEN_PERCENT = 70
SUNLIGHT_MIN_PERCENT = 30
SUNLIGHT_TARGET_HOURS = 6

# One short watering event at most once every rolling 24 hours.
# Measure the pump's delivered volume before changing this duration.
PUMP_DOSE_SECONDS = 2
SOIL_CHECK_INTERVAL_MS = 2 * 60 * 60 * 1000
WATER_LOCKOUT_MS = 24 * 60 * 60 * 1000

# Prevent another immediate watering after a restart
STARTUP_WATER_WAIT_MS = 30 * 60 * 1000

# Use your verified servo positions.
# Swap these if the canopy moves in the wrong direction.
SERVO_OPEN_US = 1500
SERVO_CLOSED_US = 2325
SERVO_MOVE_SECONDS = 1

SENSOR_INTERVAL_MS = 8000
DAY_MS = 24 * 60 * 60 * 1000

# ==================================================
# HARDWARE
# ==================================================

pump = Pin(16, Pin.OUT, value=0)

servo = PWM(Pin(14))
servo.freq(50)
servo.duty_u16(0)

temperature_sensor = dht.DHT11(Pin(17))
soil_sensor = ADC(Pin(26))

i2c = I2C(
    0,
    sda=Pin(0),
    scl=Pin(1),
    freq=10000
)

LIGHT_ADDRESS = 0x10
light_ready = False
shade_closed = None

soil_calibrated = (
    SOIL_DRY_RAW is not None
    and SOIL_WET_RAW is not None
    and SOIL_DRY_RAW > SOIL_WET_RAW
)

light_calibrated = (
    LIGHT_DARK_RAW is not None
    and LIGHT_PEAK_RAW is not None
    and 0 <= LIGHT_DARK_RAW < LIGHT_PEAK_RAW <= 65000
)

# ==================================================
# FUNCTIONS
# ==================================================

def clamp_percent(value):
    return max(0, min(100, value))


def set_shade(close):
        # ---------- Shade decision ----------
        if not sensors_ok:
            set_shade(True)

        elif temperature_f >= SHADE_EMERGENCY_F:
            set_shade(True)

        elif (
            temperature_f >= SHADE_CLOSE_F
            and light_percent >= LIGHT_CLOSE_PERCENT
        ):
            set_shade(True)

        elif (
            temperature_f <= SHADE_OPEN_F
            or light_percent < LIGHT_OPEN_PERCENT
        ):
            set_shade(False)

        # Otherwise keep last commanded position

        previous_sunlight = (
            sensors_ok
            and light_percent >= SUNLIGHT_MIN_PERCENT
            and shade_closed is False
        )

        # ---------- Soil and watering ----------
        # Read at startup, then every 2 hours.
        # Only one pump dose is allowed per rolling 24 hours.
        now = time.ticks_ms()

        if time.ticks_diff(now, soil_check_due) >= 0:
            raw, moisture = read_soil()

            print("Soil raw:", raw,
                  "| Relative moisture %:", moisture)

            soil_check_due = time.ticks_add(
                time.ticks_ms(), SOIL_CHECK_INTERVAL_MS
            )

            if moisture is None:
                print("Watering blocked: check soil calibration/wiring")

            elif moisture >= SOIL_START_PERCENT:
                print("Soil is moist enough. No watering needed.")

            elif watering_allowed_at is not None:
                print("Soil is dry; watering lockout is still active.")

            elif not sensors_ok:
                print("Watering blocked: fix temperature/light sensor")
                print("or light calibration.")

            else:
                # set_shade() has already finished any servo movement.
                water_once()
                total_waterings += 1

                # Start the 24-hour timer when watering finishes.
                watering_allowed_at = time.ticks_add(
                    time.ticks_ms(), WATER_LOCKOUT_MS
                )

                soil_check_due = time.ticks_add(
                    time.ticks_ms(), SOIL_CHECK_INTERVAL_MS
                )

                print("Watered once. No more watering for 24 hours.")

        now = time.ticks_ms()
        soil_remaining = max(
            0, time.ticks_diff(soil_check_due, now)
        )

        print("Next soil check in:",
              round(soil_remaining / 60000, 1), "minutes")

        if watering_allowed_at is not None:
            water_remaining = max(
                0, time.ticks_diff(watering_allowed_at, now)
            )

            print("Watering lockout remaining:",
                  round(water_remaining / 3600000, 2), "hours")
        else:
            print("Watering permitted at the next dry-soil check.")

        print("Unshaded sunlight:",
              round(sunlight_seconds / 3600, 2),
              "/", SUNLIGHT_TARGET_HOURS, "hours")

        print("Total watering events this run:", total_waterings)

        # Complete approximately one sensor cycle every 8 seconds
        remaining = SENSOR_INTERVAL_MS - time.ticks_diff(
            time.ticks_ms(), loop_start
        )

        if remaining > 0:
            time.sleep_ms(remaining)

except KeyboardInterrupt:
    print("\nProgram stopped")

finally:
    pump.value(0)
    servo.duty_u16(0)
    servo.deinit()
    print("Pump OFF; servo pulses stopped")
